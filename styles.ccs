body {
  margin: 0;
  font-family: 'Segoe UI', sans-serif;
  color: #222;
  background: #fff;
}

nav {
  display: flex;
  justify-content: space-between;
  padding: 20px 40px;
  background: #111;
  color: #fff;
}

.logo {
  font-size: 1.5em;
  color: orange;
  font-weight: bold;
}

.cta {
  background: orange;
  padding: 10px 20px;
  text-decoration: none;
  color: #fff;
  border-radius: 4px;
}

.hero {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  padding: 40px;
  background: #000;
  color: #fff;
}

.hero-text {
  flex: 1;
  min-width: 300px;
}

.hero h1 {
  font-size: 2.5em;
}

.hero p {
  font-size: 1.2em;
}

.hero-img {
  max-width: 400px;
  margin-left: 20px;
  border-radius: 8px;
}

.button {
  background: orange;
  color: white;
  padding: 12px 24px;
  border: none;
  border-radius: 6px;
  text-decoration: none;
  margin-top: 20px;
  display: inline-block;
}

.features {
  padding: 60px 40px;
  background: #f4f4f4;
  text-align: center;
}

.features-grid {
  display: flex;
  justify-content: space-around;
  flex-wrap: wrap;
  gap: 20px;
  margin-top: 40px;
}

.feature {
  flex: 1;
  max-width: 300px;
  background: white;
  padding: 20px;
  border-radius: 10px;
  box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

footer {
  background: darkorange;
  color: white;
  text-align: center;
  padding: 30px 20px;
}